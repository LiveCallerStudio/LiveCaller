# Public Firebase client configuration (same Firebase project used by Live Caller Studio)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=djdeeze-hotline.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=djdeeze-hotline
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=djdeeze-hotline.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Use either the JSON string or individual fields.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=djdeeze-hotline
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LiveKit Cloud or self-hosted LiveKit server credentials. NEVER use NEXT_PUBLIC_ here.
LIVEKIT_URL=wss://YOUR-LIVEKIT-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated Firebase Auth UIDs permitted to use the host control room.
HOST_UIDS=
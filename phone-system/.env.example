# LiveKit server credentials (never expose these with NEXT_PUBLIC_)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Firebase Admin service account JSON encoded as base64 (one-line)
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-me
FIREBASE_PROJECT_ID=djdeeze-hotline

# A long random value used to protect host-only API actions
HOST_DASHBOARD_KEY=replace-with-a-long-random-secret

# Optional app origin, e.g. https://phone.your-domain.com
NEXT_PUBLIC_PHONE_SYSTEM_URL=http://localhost:3000